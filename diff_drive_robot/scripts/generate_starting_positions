# Run once for your map to generate random starting positions for the robot. 
# This will create a CSV file with random (x, y, yaw) poses with minimum 0.25m distance to nearest obstacle in free space on the map. 
# You can then use this CSV in your launch file to set the initial pose of the robot for each run.
import os
import numpy as np
import yaml
from PIL import Image
from ament_index_python.packages import get_package_share_directory

def generate_poses(num_poses=50):
   
    # Ensure this path is correct for the SLAM generated map (see mapping_launch.py if you need to create one)  # Update this to your map YAML file
    map_yaml = os.path.join(get_package_share_directory('diff_drive_robot'), 'maps', 'my_map.yaml')  
    
    with open(map_yaml, 'r') as f:
        data = yaml.safe_load(f)
    
    resolution = data['resolution']
    origin = data['origin'] # [x, y, yaw]
    map_img = Image.open(data['image'])
    grid = np.array(map_img)

    # In PGM, 0 is occupied (black), 254/255 is free (white)
    free_cells = np.argwhere(grid > 250) 
    
    # Randomly select indices
    selected_indices = free_cells[np.random.choice(len(free_cells), num_poses)]
    
    poses = []
    for idx in selected_indices:
        # Convert pixel to world coordinates
        # Map origin is usually the bottom-left corner
        x = idx[1] * resolution + origin[0]
        y = (grid.shape[0] - idx[0]) * resolution + origin[1]
        yaw = np.random.uniform(-np.pi, np.pi)
        poses.append((x, y, yaw))
        
    return poses

# Save these to a CSV for your launch file to read